{
  "name": "klakboard",
  "version": "1.8.0",
  "description": "Dashboard for secondary displays: markets (metals, currencies, crypto), weather and system monitoring",
  "main": "main.js",
  "author": "Klakh",
  "license": "MIT",
  "homepage": "https://github.com/LokLakh-s/Klakboard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LokLakh-s/Klakboard.git"
  },
  "bugs": {
    "url": "https://github.com/LokLakh-s/Klakboard/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/main.test.js test/units.test.js test/system.smoke.test.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.klakh.klakboard",
    "productName": "Klakboard",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "markets.js",
      "system.js",
      "index.html",
      "renderer.js",
      "style.css",
      "build/icon.ico",
      "weather.js",
      "updates.js",
      "updater.js",
      "display.js",
      "token.js",
      "i18n.js",
      "icons/**/*",
      "autostart.js",
      "platform/**/*",
      "fonts/**/*",
      "build/tray.png",
      "build/tray@2x.png",
      "build/tray-linux.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/logo.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "Klakboard-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/logo.png",
      "maintainer": "Klakh <6003117+Klakh@users.noreply.github.com>",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "artifactName": "Klakboard-${version}-${arch}.${ext}"
    }
  }
}
