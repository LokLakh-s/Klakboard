{
  "name": "klakboard",
  "version": "1.6.0",
  "description": "Dashboard for secondary displays: markets (metals, currencies, crypto), weather and system monitoring",
  "main": "main.js",
  "author": "Klakh",
  "license": "MIT",
  "homepage": "https://github.com/LokLakh-s/Klakboard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LokLakh-s/Klakboard.git"
  },
  "bugs": {
    "url": "https://github.com/LokLakh-s/Klakboard/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/main.test.js test/units.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.klakh.klakboard",
    "productName": "Klakboard",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "markets.js",
      "system.js",
      "index.html",
      "renderer.js",
      "style.css",
      "build/icon.ico",
      "weather.js",
      "updates.js",
      "updater.js",
      "display.js",
      "token.js",
      "icons/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
